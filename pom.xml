<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.piotr-janczukowicz</groupId>
    <artifactId>common-parent</artifactId>
    <version>15</version>
    <relativePath/>
  </parent>

  <artifactId>gitlab-rest-client</artifactId>
  <version>19.6.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>gitlab-rest-client</name>
  <description>Java client for the GitLab REST API</description>
  <url>https://github.com/piotr-janczukowicz/gitlab-rest-client</url>

  <properties>
    <common-core.version>6</common-core.version>
    <gitlab-client.version>1</gitlab-client.version>
    <junit.parallel.enabled>true</junit.parallel.enabled>
    <test.module.args>-Xmx3g --add-modules jdk.httpserver --add-reads io.github.piotr_janczukowicz.gitlabrestclient=jdk.httpserver --add-opens io.github.piotr_janczukowicz.gitlabrestclient/io.github.piotr_janczukowicz.gitlab.test=common.core</test.module.args>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.piotr-janczukowicz</groupId>
      <artifactId>gitlab-client</artifactId>
      <version>${gitlab-client.version}</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>io.soabase.record-builder</groupId>
      <artifactId>record-builder-core</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.github.piotr-janczukowicz</groupId>
      <artifactId>common-core</artifactId>
      <version>${common-core.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.wiremock</groupId>
      <artifactId>wiremock</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <executions>
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <compilerArgs>
                <arg>--add-modules</arg>
                <arg>jdk.httpserver</arg>
                <arg>--add-reads</arg>
                <arg>io.github.piotr_janczukowicz.gitlabrestclient=jdk.httpserver</arg>
              </compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <groups>unit</groups>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <groups>integration</groups>
          <includes>
            <include>**/*Test.java</include>
            <include>**/*IT.java</include>
            <include>**/*ITCase.java</include>
          </includes>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>smoke</id>
      <properties>
        <jacoco.skip>true</jacoco.skip>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <groups combine.self="override">smoke</groups>
              <includes combine.children="override">
                <include>**/smoke/*SmokeIT.java</include>
              </includes>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
